<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Product</title>
    <link rel="stylesheet" href="/styles/update-product.css">
</head>
<body>
    <nav>
        <a href="/products" class="logo">Logo</a>
    </nav>

    <div class="update-product-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-section-label">Navigation</div>
            <a href="admin-dashboard">Admin Dashboard</a>
            <a href="products">View All Products</a>
            <a href="users">View All Users</a>

            <!-- Logout Form -->
            <form action="logout" method="get" class="logout-form">
                <button type="submit" class="logout-btn">Logout</button>
            </form>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="page-header">
                <h1>Product <span>Management</span></h1>
            </header>

            <div class="form-card">
                <div class="form-card-header">
                    <div class="header-icon">✏️</div>
                    <div>
                        <h2>Update Product</h2>
                        <p>Modify the pricing information for this item</p>
                    </div>
                </div>

                <div class="form-card-body">
                    <form action="/products/{{id}}?_method=PATCH" method="POST">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="name">Name</label>
                                <input type="text" name="name" id="name" value="{{product.name}}" required disabled>
                            </div>

                            <div class="form-group">
                                <label for="type">Type</label>
                                <input type="text" name="type" id="type" value="{{product.type}}" required disabled>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="price">Price</label>
                            <input type="number" name="price" id="price" value="{{product.price}}" required>
                        </div>

                        <div class="form-actions">
                            <a href="/products" class="btn-cancel">Cancel</a>
                            <button class="btn-submit" type="submit">Update Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script>
        function handleMenu() {
            const sidebar = document.querySelector(".sidebar");
            if (sidebar) {
                sidebar.classList.toggle("open");
            } else {
                console.error("Sidebar element not found in the DOM!");
            }
        }
    </script>
</body>
</html>